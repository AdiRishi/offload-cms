From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Offload <offload@localhost>
Date: Tue, 20 Oct 2026 00:07:42 +1100
Subject: [PATCH] fix(drizzle): turn D1 unique constraint failures into
 validation errors

On D1, saving a document with a duplicate value in a unique field returns a
500 instead of the 400 with "Value must be unique" on the field that SQLite
and Postgres give. handleUpsertError recognises a unique violation by the
driver error's code, 23505 on Postgres and SQLITE_CONSTRAINT_UNIQUE on
libSQL. D1 errors have no code. D1 puts SQLite's message and result code in
the message instead: "D1_ERROR: UNIQUE constraint failed: posts.slug:
SQLITE_CONSTRAINT (extended: SQLITE_CONSTRAINT_UNIQUE)".

handleUpsertError now reads a D1 unique constraint failure from that message
and handles it as a SQLite one, so the field's path comes from the column in
the message. The match needs the message to start with "D1_ERROR:", which
Postgres and libSQL errors never do, so they take the same path as before.

Offload-Patch: d1-unique-constraint-errors
Drop-When: the pinned release turns D1's unique constraint errors into a ValidationError
Tests: pnpm exec vitest run --project unit packages/drizzle/src/upsertRow/handleUpsertError.spec.ts; e2e suite (tests/database.spec.ts)
---
 .../src/upsertRow/handleUpsertError.spec.ts   | 48 +++++++++++++++++++
 .../src/upsertRow/handleUpsertError.ts        | 13 ++++-
 2 files changed, 60 insertions(+), 1 deletion(-)

diff --git a/packages/drizzle/src/upsertRow/handleUpsertError.spec.ts b/packages/drizzle/src/upsertRow/handleUpsertError.spec.ts
index a8715eb1e..f91cd5dbc 100644
--- a/packages/drizzle/src/upsertRow/handleUpsertError.spec.ts
+++ b/packages/drizzle/src/upsertRow/handleUpsertError.spec.ts
@@ -1,3 +1,4 @@
+import { DrizzleQueryError } from 'drizzle-orm'
 import { ValidationError } from 'payload'
 import { describe, expect, it } from 'vitest'
 
@@ -34,6 +35,53 @@ describe('handleUpsertError', () => {
     expect(fieldError.tableName).toBe('ultrasonic_avail_country')
   })
 
+  it('turns a D1 unique constraint failure into a ValidationError on the field', () => {
+    const d1Message =
+      'UNIQUE constraint failed: pages.meta_slug: SQLITE_CONSTRAINT (extended: SQLITE_CONSTRAINT_UNIQUE)'
+    const d1Error = new Error(`D1_ERROR: ${d1Message}`, { cause: new Error(d1Message) })
+    const queryError = new DrizzleQueryError(
+      'insert into "pages" ("meta_slug") values (?) returning "id"',
+      ['home'],
+      d1Error,
+    )
+
+    let thrown: unknown
+    try {
+      handleUpsertError({
+        adapter: {
+          fieldConstraints: { pages: { meta_slug_idx: 'meta.slug' } },
+        } as unknown as DrizzleAdapter,
+        collectionSlug: 'pages',
+        error: queryError,
+        tableName: 'pages',
+      })
+    } catch (error) {
+      thrown = error
+    }
+
+    expect(thrown).toBeInstanceOf(ValidationError)
+    expect((thrown as ValidationError).data.errors).toEqual([
+      { message: 'Value must be unique', path: 'meta.slug', tableName: 'pages' },
+    ])
+  })
+
+  it('re-throws other D1 errors unchanged', () => {
+    const queryError = new DrizzleQueryError(
+      'select "id" from "pages"',
+      [],
+      new Error('D1_ERROR: database is locked: SQLITE_BUSY'),
+    )
+
+    expect(() =>
+      handleUpsertError({
+        adapter,
+        collectionSlug: 'pages',
+        error: queryError,
+        tableName: 'pages',
+      }),
+    ).toThrow(queryError)
+  })
+
   it('re-throws non unique-constraint errors unchanged', () => {
     const otherError = new Error('some other db error')
 
diff --git a/packages/drizzle/src/upsertRow/handleUpsertError.ts b/packages/drizzle/src/upsertRow/handleUpsertError.ts
index 305bf7d37..5d3a34384 100644
--- a/packages/drizzle/src/upsertRow/handleUpsertError.ts
+++ b/packages/drizzle/src/upsertRow/handleUpsertError.ts
@@ -15,7 +15,13 @@ type HandleUpsertErrorArgs = {
 }
 
 /**
- * Handles unique constraint violation errors from PostgreSQL and SQLite,
+ * D1 errors have no code. D1 puts SQLite's message and result code in the error's message, as in
+ * "D1_ERROR: UNIQUE constraint failed: posts.slug: SQLITE_CONSTRAINT (extended: SQLITE_CONSTRAINT_UNIQUE)".
+ */
+const d1UniqueConstraint = /^D1_ERROR: (UNIQUE constraint failed: [^:]+): SQLITE_CONSTRAINT\b/
+
+/**
+ * Handles unique constraint violation errors from PostgreSQL, SQLite and D1,
  * converting them to Payload ValidationErrors.
  * Re-throws non-constraint errors unchanged.
  */
@@ -33,6 +39,11 @@ export const handleUpsertError = ({
     error = caughtError.cause
   }
 
+  const d1Unique = typeof error?.message === 'string' && error.message.match(d1UniqueConstraint)
+  if (d1Unique) {
+    error = { code: 'SQLITE_CONSTRAINT_UNIQUE', message: d1Unique[1] }
+  }
+
   // PostgreSQL: 23505, SQLite: SQLITE_CONSTRAINT_UNIQUE
   if (error?.code === '23505' || error?.code === 'SQLITE_CONSTRAINT_UNIQUE') {
     let fieldName: null | string = null
