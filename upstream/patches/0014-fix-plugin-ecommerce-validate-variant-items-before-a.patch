+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('payload', () => ({ addDataAndFileToRequest: vi.fn() }))
+
+import { initiatePaymentHandler } from './initiatePayment.js'
+
+type Handler = ReturnType<typeof initiatePaymentHandler>
+type Request = Parameters<Handler>[0]
+
+const documents: Record<string, Record<string, unknown>> = {
+  'products:shirt': { enableVariants: true, id: 'shirt', priceInMUR: 900 },
+  'products:sticker': { id: 'sticker', inventory: 10, priceInMUR: 50 },
+  'products:unreleased': { _status: 'draft', id: 'unreleased', inventory: 10, priceInMUR: 50 },
+  'variants:shirt-large': { id: 'shirt-large', inventory: 3, priceInMUR: 1500, product: 'shirt' },
+  'variants:shirt-sold-out': {
+    id: 'shirt-sold-out',
+    inventory: 0,
+    priceInMUR: 1500,
+    product: 'shirt',
+  },
+  'variants:sticker-holo': {
+    id: 'sticker-holo',
+    inventory: 10,
+    priceInMUR: 80,
+    product: 'sticker',
+  },
+}
+
+const initiate = async (
+  items: Record<string, unknown>[],
+  cartFields: Record<string, unknown> = {},
+) => {
+  const initiatePayment = vi.fn(async () => ({ message: 'Payment initiated' }))
+  const handler = initiatePaymentHandler({
+    currenciesConfig: {
+      defaultCurrency: 'MUR',
+      supportedCurrencies: [{ code: 'MUR', decimals: 2, label: 'Mauritian Rupee', symbol: 'Rs' }],
+    },
+    paymentMethod: {
+      confirmOrder: vi.fn(),
+      group: { name: 'test', type: 'group', fields: [] },
+      initiatePayment,
+      name: 'test',
+    },
+  })
+  const cart = { currency: 'MUR', id: 'cart-1', items, subtotal: 0, ...cartFields }
+  const req = {
+    data: { cartID: 'cart-1', customerEmail: 'buyer@example.com' },
+    payload: {
+      findByID: vi.fn(async ({ collection, id }: { collection: string; id: string }) =>
+        collection === 'carts' ? cart : (documents[`${collection}:${id}`] ?? null),
+      ),
+      logger: { error: vi.fn() },
+      update: vi.fn(async () => cart),
+    },
+    query: {},
+  } as unknown as Request
+
+  const response = await handler(req)
+
+  return { initiatePayment, response, update: req.payload.update }
+}
+
+describe('initiatePaymentHandler', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it('starts a payment for a variant of the cart item product', async () => {
+    const { initiatePayment, response } = await initiate(
+      [{ product: 'shirt', quantity: 2, variant: 'shirt-large' }],
+      { subtotal: 3000 },
+    )
+
+    expect(response.status).toBe(200)
+    expect(initiatePayment).toHaveBeenCalled()
+  })
+
+  it('refuses a variant of another product, whose price the cart would charge', async () => {
+    const { initiatePayment, response } = await initiate([
+      { product: 'shirt', quantity: 1, variant: 'sticker-holo' },
+    ])
+
+    expect(response.status).toBe(400)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a product with variants bought without one', async () => {
+    const { initiatePayment, response } = await initiate([{ product: 'shirt', quantity: 1 }])
+
+    expect(response.status).toBe(400)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a variant that is out of stock', async () => {
+    const { initiatePayment, response } = await initiate([
+      { product: 'shirt', quantity: 1, variant: 'shirt-sold-out' },
+    ])
+
+    expect(response.status).toBe(400)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a variant without a price in the cart currency', async () => {
+    documents['variants:shirt-unpriced'] = { id: 'shirt-unpriced', inventory: 5, product: 'shirt' }
+
+    const { initiatePayment, response } = await initiate([
+      { product: 'shirt', quantity: 1, variant: 'shirt-unpriced' },
+    ])
+
+    expect(response.status).toBe(400)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a fractional quantity, which would decrement stock by a fraction', async () => {
+    const { initiatePayment, response } = await initiate([{ product: 'sticker', quantity: 1.5 }])
+
+    expect(response.status).toBe(400)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a cart that has already been bought', async () => {
+    const { initiatePayment, response } = await initiate([{ product: 'sticker', quantity: 1 }], {
+      purchasedAt: '2026-10-20T00:00:00.000Z',
+    })
+
+    expect(response.status).toBe(400)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a product that has never been published', async () => {
+    const { initiatePayment, response } = await initiate([{ product: 'unreleased', quantity: 1 }], {
+      subtotal: 50,
+    })
+
+    expect(response.status).toBe(404)
+    expect(initiatePayment).not.toHaveBeenCalled()
+  })
+
+  it('refuses a cart whose subtotal predates a price change, and saves it again', async () => {
+    const { initiatePayment, response, update } = await initiate(
+      [{ product: 'shirt', quantity: 2, variant: 'shirt-large' }],
+      { subtotal: 2400 },
+    )
+
+    expect(response.status).toBe(409)
+    expect(initiatePayment).not.toHaveBeenCalled()
+    expect(update).toHaveBeenCalledWith(
+      expect.objectContaining({ collection: 'carts', id: 'cart-1' }),
+    )
+  })
+})
