@@ -0,0 +1,167 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const payloadUtilities = vi.hoisted(() => ({
+  commitTransaction: vi.fn(),
+  initTransaction: vi.fn(),
+  killTransaction: vi.fn(),
+}))
+
+vi.mock('payload', () => payloadUtilities)
+
+import { settleTransaction } from './settleTransaction.js'
+
+type Request = Parameters<typeof settleTransaction>[0]['req']
+
+const orderData = {
+  amount: 2500,
+  currency: 'MUR',
+  customerEmail: 'buyer@example.com',
+  items: [{ product: 7, quantity: 1, variant: 11 }],
+  status: 'processing',
+}
+
+const createStore = (transaction: Record<string, unknown>) => {
+  const state = {
+    cart: { id: 3, purchasedAt: undefined as string | undefined },
+    inventory: new Map<string, number>([
+      ['products:7', 5],
+      ['variants:11', 5],
+    ]),
+    orders: [] as Record<string, unknown>[],
+    transaction: { ...transaction },
+  }
+
+  const matches = (where: Record<string, any>) =>
+    where.and.every((condition: Record<string, any>) => {
+      if (condition.id) {
+        return condition.id.equals === state.transaction.id
+      }
+      if (condition.status) {
+        return condition.status.equals === state.transaction.status
+      }
+      return condition.order.exists === Boolean(state.transaction.order)
+    })
+
+  const payload = {
+    create: vi.fn(async ({ data }: { data: Record<string, unknown> }) => {
+      const order = { ...data, id: state.orders.length + 100 }
+      state.orders.push(order)
+      return order
+    }),
+    db: {
+      updateOne: vi.fn(
+        async ({
+          collection,
+          data,
+          id,
+          where,
+        }: {
+          collection: string
+          data: Record<string, any>
+          id?: number
+          where?: Record<string, any>
+        }) => {
+          if (collection === 'transactions') {
+            if (!where || !matches(where)) {
+              return null
+            }
+            state.transaction = { ...state.transaction, ...data }
+            return { ...state.transaction }
+          }
+          const key = `${collection}:${id}`
+          state.inventory.set(key, (state.inventory.get(key) ?? 0) + data.inventory.$inc)
+          return { id }
+        },
+      ),
+    },
+    find: vi.fn(async ({ where }: { where: Record<string, any> }) => {
+      const docs = state.orders.filter((order) =>
+        (order.transactions as unknown[]).includes(where.transactions.equals),
+      )
+      return { docs, totalDocs: docs.length }
+    }),
+    findByID: vi.fn(async ({ collection }: { collection: string }) =>
+      collection === 'transactions' ? { ...state.transaction } : null,
+    ),
+    update: vi.fn(
+      async ({ collection, data }: { collection: string; data: Record<string, unknown> }) => {
+        if (collection === 'carts') {
+          state.cart = { ...state.cart, ...data }
+          return state.cart
+        }
+        state.transaction = { ...state.transaction, ...data }
+        return state.transaction
+      },
+    ),
+  }
+
+  const req = { payload } as unknown as Request
+
+  return { payload, req, state }
+}
+
+const pendingTransaction = {
+  cart: 3,
+  id: 42,
+  items: [{ product: 7, quantity: 1, variant: 11 }],
+  order: null,
+  status: 'pending',
+}
+
+describe('settleTransaction', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    payloadUtilities.initTransaction.mockResolvedValue(false)
+  })
+
+  it('creates the order and applies the cart and inventory side effects once', async () => {
+    const { req, state } = createStore(pendingTransaction)
+
+    const first = await settleTransaction({ orderData, req, transactionID: 42 })
+    const second = await settleTransaction({ orderData, req, transactionID: 42 })
+
+    expect(second.id).toBe(first.id)
+    expect(state.orders).toHaveLength(1)
+    expect(state.orders[0]).toMatchObject({ ...orderData, transactions: [42] })
+    expect(state.transaction).toMatchObject({ order: first.id, status: 'succeeded' })
+    expect(state.cart.purchasedAt).toEqual(expect.any(String))
+    expect(state.inventory.get('variants:11')).toBe(4)
+    expect(state.inventory.get('products:7')).toBe(5)
+  })
+
+  it('refuses a transaction that is no longer pending and writes nothing', async () => {
+    const { req, state } = createStore({ ...pendingTransaction, status: 'expired' })
+
+    await expect(settleTransaction({ orderData, req, transactionID: 42 })).rejects.toThrow(
+      'Transaction is not available for settlement.',
+    )
+    expect(state.orders).toHaveLength(0)
+    expect(state.inventory.get('variants:11')).toBe(5)
+  })
+
+  it('refuses a transaction without a cart before claiming it', async () => {
+    const { req, state } = createStore({ ...pendingTransaction, cart: null })
+
+    await expect(settleTransaction({ orderData, req, transactionID: 42 })).rejects.toThrow(
+      'Transaction has no cart to settle.',
+    )
+    expect(state.transaction.status).toBe('pending')
+  })
+
+  it('commits the database transaction it opened, and rolls it back on failure', async () => {
+    payloadUtilities.initTransaction.mockResolvedValue(true)
+    const settled = createStore(pendingTransaction)
+
+    await settleTransaction({ orderData, req: settled.req, transactionID: 42 })
+
+    expect(payloadUtilities.commitTransaction).toHaveBeenCalledWith(settled.req)
+
+    const failing = createStore(pendingTransaction)
+    failing.payload.create.mockRejectedValueOnce(new Error('order insert failed'))
+
+    await expect(
+      settleTransaction({ orderData, req: failing.req, transactionID: 42 }),
+    ).rejects.toThrow('order insert failed')
+    expect(payloadUtilities.killTransaction).toHaveBeenCalledWith(failing.req)
+  })
+})
