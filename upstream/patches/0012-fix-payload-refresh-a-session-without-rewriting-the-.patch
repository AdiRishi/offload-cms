+import { describe, expect, it } from 'vitest'
+
+import type { DrizzleAdapter } from '../types.js'
+
+import { updateArrayRows } from './updateArrayRows.js'
+
+const usersSessions = sqliteTable('users_sessions', {
+  id: text('id').primaryKey(),
+  _parentID: integer('_parent_id').notNull(),
+  createdAt: text('created_at'),
+  expiresAt: text('expires_at').notNull(),
+})
+
+const fields = [
+  { name: 'name', type: 'text' },
+  {
+    name: 'sessions',
+    type: 'array',
+    flattenedFields: [
+      { name: 'id', type: 'text' },
+      { name: 'createdAt', type: 'date' },
+      { name: 'expiresAt', type: 'date' },
+    ],
+  },
+] as unknown as FlattenedField[]
+
+const setup = async () => {
+  const client = createClient({ url: ':memory:' })
+  await client.execute(
+    'CREATE TABLE users_sessions (id TEXT PRIMARY KEY, _parent_id INTEGER, created_at TEXT, expires_at TEXT)',
+  )
+  const db = drizzle(client)
+  const adapter = {
+    tableNameMap: new Map([['users_sessions', 'users_sessions']]),
+    tables: { users_sessions: usersSessions },
+  } as unknown as DrizzleAdapter
+
+  return { adapter, db }
+}
+
+describe('updateArrayRows', () => {
+  it("sets the given columns of only the named rows of the parent's array", async () => {
+    const { adapter, db } = await setup()
+    const createdAt = '2026-01-01T00:00:00.000Z'
+    const expiresAt = '2026-01-01T02:00:00.000Z'
+    await db.insert(usersSessions).values([
+      { id: 'refreshed', _parentID: 1, createdAt, expiresAt },
+      { id: 'other', _parentID: 1, createdAt, expiresAt },
+      { id: 'other-users', _parentID: 2, createdAt, expiresAt },
+    ])
+
+    const remainingData = await updateArrayRows({
+      adapter,
+      data: {
+        name: 'Ada',
+        sessions: {
+          $update: [
+            { id: 'refreshed', expiresAt: new Date('2026-01-01T03:00:00.000Z') },
+            { id: 'other-users', expiresAt: new Date('2026-01-01T03:00:00.000Z') },
+          ],
+        },
+      },
+      db,
+      fields,
+      parentID: 1,
+      tableName: 'users',
+    })
+
+    expect(remainingData).toEqual({ name: 'Ada' })
+    expect(await db.select().from(usersSessions).orderBy(usersSessions.id)).toEqual([
+      { id: 'other', _parentID: 1, createdAt, expiresAt },
+      { id: 'other-users', _parentID: 2, createdAt, expiresAt },
+      { id: 'refreshed', _parentID: 1, createdAt, expiresAt: '2026-01-01T03:00:00.000Z' },
+    ])
+  })
+})
diff --git a/packages/drizzle/src/upsertRow/updateArrayRows.ts b/packages/drizzle/src/upsertRow/updateArrayRows.ts
new file mode 100644
index 000000000..53470b796
--- /dev/null
+++ b/packages/drizzle/src/upsertRow/updateArrayRows.ts
@@ -0,0 +1,67 @@
+import type { LibSQLDatabase } from 'drizzle-orm/libsql'
+import type { FlattenedField } from 'payload'
+
+import { and, eq } from 'drizzle-orm'
+import toSnakeCase from 'to-snake-case'
+
+import type { DrizzleAdapter, DrizzleTransaction } from '../types.js'
+
+import { transformForWrite } from '../transform/write/index.js'
+
+type Args = {
+  adapter: DrizzleAdapter
+  data: Record<string, unknown>
+  db: DrizzleAdapter['drizzle'] | DrizzleTransaction
+  fields: FlattenedField[]
+  parentID: number | string
+  tableName: string
+}
+
+/**
+ * Updates the rows that `{ [arrayField]: { $update: row | row[] } }` names by `row.id` in
+ * top-level array fields, and returns the data without those operations. Each row sets only the
+ * columns of the array's own table, so nested arrays, blocks and localized fields are not written.
+ */
+export const updateArrayRows = async ({
+  adapter,
+  data,
+  db,
+  fields,
+  parentID,
+  tableName,
+}: Args): Promise<Record<string, unknown>> => {
+  const remainingData = { ...data }
+
+  for (const field of fields) {
+    const value = data[field.name]
+
+    if (field.type !== 'array' || typeof value !== 'object' || !value || !('$update' in value)) {
+      continue
+    }
+
+    const rows = (Array.isArray(value.$update) ? value.$update : [value.$update]) as Record<
+      string,
+      unknown
+    >[]
+    const arrayTableName = adapter.tableNameMap.get(`${tableName}_${toSnakeCase(field.name)}`)
+    const table = adapter.tables[arrayTableName]
+
+    for (const { id, ...rowData } of rows) {
+      const { row } = transformForWrite({
+        adapter,
+        data: rowData,
+        fields: field.flattenedFields,
+        tableName: arrayTableName,
+      })
+
+      await (db as LibSQLDatabase)
+        .update(table)
+        .set(row)
+        .where(and(eq(table._parentID, parentID), eq(table.id, id)))
+    }
+
+    delete remainingData[field.name]
+  }
+
+  return remainingData
+}
