diff --git a/packages/storage-r2/src/entryImports.spec.ts b/packages/storage-r2/src/entryImports.spec.ts
new file mode 100644
index 000000000..db4873e7e
--- /dev/null
+++ b/packages/storage-r2/src/entryImports.spec.ts
@@ -0,0 +1,30 @@
+import path from 'node:path'
+import { build } from 'vite'
+import { describe, expect, it } from 'vitest'
+
+const entryImports = async (entry: string): Promise<string[]> => {
+  const result = await build({
+    build: {
+      lib: { entry: path.resolve(import.meta.dirname, entry), formats: ['es'] },
+      rollupOptions: { external: (id) => !id.startsWith('.') && !path.isAbsolute(id) },
+      write: false,
+    },
+    configFile: false,
+    logLevel: 'silent',
+  })
+
+  return [result]
+    .flat()
+    .flatMap((bundle) => ('output' in bundle ? bundle.output : []))
+    .flatMap((file) => (file.type === 'chunk' ? [...file.imports, ...file.dynamicImports] : []))
+}
+
+describe('entry imports', () => {
+  // A dynamic import still puts the AWS SDK in a Cloudflare Worker's bundle.
+  it('should not import the AWS SDK from the main entry', async () => {
+    const imports = await entryImports('index.ts')
+
+    expect(imports).toContain('@payloadcms/plugin-cloud-storage')
+    expect(imports.filter((id) => /^@aws-sdk\/|^@payloadcms\/storage-s3/.test(id))).toEqual([])
+  })
+})
diff --git a/packages/storage-r2/src/exports/copyFile.ts b/packages/storage-r2/src/exports/copyFile.ts
new file mode 100644
index 000000000..e5238c495
--- /dev/null
+++ b/packages/storage-r2/src/exports/copyFile.ts
@@ -0,0 +1,34 @@
+import type { CopyFile } from '@payloadcms/plugin-cloud-storage/types'
+
+import { S3 } from '@aws-sdk/client-s3'
+import { copyS3File } from '@payloadcms/storage-s3/copy-file'
+
+export type R2S3Credentials = {
+  accessKeyId: string
+  accountId: string
+  bucket: string
+  secretAccessKey: string
+}
+
+/**
+ * Copies objects through R2's S3-compatible API. Kept out of the main entry so a
+ * Worker that never copies files doesn't bundle the AWS SDK.
+ */
+export const createS3CopyFile =
+  (credentials: R2S3Credentials): CopyFile =>
+  async ({ from, req, to }) => {
+    const client = new S3({
+      credentials: {
+        accessKeyId: credentials.accessKeyId,
+        secretAccessKey: credentials.secretAccessKey,
+      },
+      endpoint: `https://${credentials.accountId}.r2.cloudflarestorage.com`,
+      region: 'auto',
+    })
+
+    try {
+      await copyS3File({ bucket: credentials.bucket, client, from, req, to })
+    } finally {
+      client.destroy()
+    }
+  }
