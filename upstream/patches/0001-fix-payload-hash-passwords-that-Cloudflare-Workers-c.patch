+/** Whether a hash has the format and parameters that new hashes get, so it needs no rehash. */
+export const isCurrentPasswordHash = (hash: unknown): hash is string => {
+  if (typeof hash !== 'string' || !currentPasswordHashRegex.test(hash)) {
+    return false
+  }
+  const { iterations, keyLength } = getPasswordHashParameters(hash)
+  return iterations === currentPasswordHashIterations && keyLength === currentPasswordHashKeyLength
+}
 
