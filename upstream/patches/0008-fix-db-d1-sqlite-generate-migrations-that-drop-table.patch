diff --git a/packages/db-d1-sqlite/src/requireDrizzleKit.spec.ts b/packages/db-d1-sqlite/src/requireDrizzleKit.spec.ts
new file mode 100644
index 000000000..d6c91d218
--- /dev/null
+++ b/packages/db-d1-sqlite/src/requireDrizzleKit.spec.ts
@@ -0,0 +1,77 @@
+import type { PlatformProxy } from 'wrangler'
+
+import { defaultDrizzleSnapshot } from '@payloadcms/drizzle/sqlite'
+import { sql } from 'drizzle-orm'
+import { type AnyD1Database, drizzle } from 'drizzle-orm/d1'
+import { integer, sqliteTable } from 'drizzle-orm/sqlite-core'
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+
+import { requireDrizzleKit } from './requireDrizzleKit.js'
+
+// Payload's tables for a collection with versions and a relationship, in the order Payload builds them.
+const pages = sqliteTable('pages', { id: integer('id').primaryKey() })
+const pagesVersions = sqliteTable('_pages_v', {
+  id: integer('id').primaryKey(),
+  parent: integer('parent_id').references(() => pages.id, { onDelete: 'set null' }),
+})
+const pagesVersionsRels = sqliteTable('_pages_v_rels', {
+  id: integer('id').primaryKey(),
+  pagesID: integer('pages_id').references(() => pages.id, { onDelete: 'cascade' }),
+  parent: integer('parent_id').references(() => pagesVersions.id, { onDelete: 'cascade' }),
+})
+
+describe('requireDrizzleKit', () => {
+  let configDir: string
+  let platform: PlatformProxy<{ DB: AnyD1Database }>
+
+  beforeAll(async () => {
+    configDir = mkdtempSync(path.join(tmpdir(), 'd1-drizzle-kit-'))
+    writeFileSync(
+      path.join(configDir, 'wrangler.json'),
+      JSON.stringify({
+        compatibility_date: '2026-01-01',
+        d1_databases: [{ binding: 'DB', database_id: 'drizzle-kit', database_name: 'test' }],
+        name: 'd1-drizzle-kit',
+      }),
+    )
+    const { getPlatformProxy } = await import('wrangler')
+    platform = await getPlatformProxy({
+      configPath: path.join(configDir, 'wrangler.json'),
+      persist: false,
+    })
+  })
+
+  afterAll(async () => {
+    await platform.dispose()
+    rmSync(configDir, { force: true, recursive: true })
+  })
+
+  it('generates a down migration that D1 runs on tables with rows', async () => {
+    const { generateDrizzleJson, generateMigration } = requireDrizzleKit()
+    const schema = await generateDrizzleJson({
+      pages,
+      _pages_v: pagesVersions,
+      _pages_v_rels: pagesVersionsRels,
+    })
+    const db = drizzle(platform.env.DB)
+
+    for (const statement of await generateMigration(defaultDrizzleSnapshot, schema)) {
+      await db.run(sql.raw(statement))
+    }
+    await db.run(sql`INSERT INTO pages VALUES (1)`)
+    await db.run(sql`INSERT INTO _pages_v VALUES (1, 1)`)
+    await db.run(sql`INSERT INTO _pages_v_rels VALUES (1, 1, 1)`)
+
+    for (const statement of await generateMigration(schema, defaultDrizzleSnapshot)) {
+      await db.run(sql.raw(statement))
+    }
+
+    const tables = await db.all<{ name: string }>(
+      sql`SELECT name FROM sqlite_master WHERE type = 'table'`,
+    )
+    expect(tables.map(({ name }) => name)).toEqual(['_cf_METADATA'])
+  })
+})
diff --git a/packages/db-d1-sqlite/src/requireDrizzleKit.ts b/packages/db-d1-sqlite/src/requireDrizzleKit.ts
new file mode 100644
index 000000000..7d0543d77
--- /dev/null
+++ b/packages/db-d1-sqlite/src/requireDrizzleKit.ts
@@ -0,0 +1,38 @@
+import type { RequireDrizzleKit } from '@payloadcms/drizzle'
+
+import { requireDrizzleKit as requireSQLiteDrizzleKit } from '@payloadcms/drizzle/sqlite'
+
+import { dropOrder } from './dropOrder.js'
+
+type Snapshot = {
+  tables: Record<string, { foreignKeys: Record<string, { tableTo: string }> }>
+}
+
+const inDropOrder = (snapshot: Snapshot): Snapshot => {
+  const order = dropOrder(
+    Object.fromEntries(
+      Object.entries(snapshot.tables).map(([name, table]) => [
+        name,
+        Object.values(table.foreignKeys).map(({ tableTo }) => tableTo),
+      ]),
+    ),
+  )
+
+  return {
+    ...snapshot,
+    tables: Object.fromEntries(order.map((name) => [name, snapshot.tables[name]!])),
+  }
+}
+
+/**
+ * drizzle-kit drops tables in the order of the snapshot that a migration starts from. Putting that
+ * snapshot in drop order makes the DROP TABLE statements of a generated migration run on D1.
+ */
+export const requireDrizzleKit: RequireDrizzleKit = () => {
+  const drizzleKit = requireSQLiteDrizzleKit()
+
+  return {
+    ...drizzleKit,
+    generateMigration: (prev, cur) => drizzleKit.generateMigration(inDropOrder(prev), cur),
+  }
+}
