@@ -0,0 +1,99 @@
+import type { PlatformProxy } from 'wrangler'
+
+import { sql } from 'drizzle-orm'
+import { type AnyD1Database, drizzle } from 'drizzle-orm/d1'
+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+import { afterAll, afterEach, beforeAll, beforeEach, describe, expect, it } from 'vitest'
+
+import type { SQLiteD1Adapter } from './types.js'
+
+import { dropDatabase } from './dropDatabase.js'
+
+// A collection with versions and a relationship, and two collections that reference each other.
+const schema = [
+  'CREATE TABLE users (id integer PRIMARY KEY, avatar_id integer REFERENCES media(id))',
+  'CREATE TABLE media (id integer PRIMARY KEY, uploaded_by_id integer REFERENCES users(id))',
+  'CREATE TABLE pages (id integer PRIMARY KEY)',
+  'CREATE TABLE _pages_v (id integer PRIMARY KEY, parent_id integer REFERENCES pages(id) ON DELETE set null)',
+  'CREATE TABLE _pages_v_rels (id integer PRIMARY KEY, parent_id integer REFERENCES _pages_v(id) ON DELETE cascade, pages_id integer REFERENCES pages(id) ON DELETE cascade)',
+  'INSERT INTO users VALUES (1, 1)',
+  'INSERT INTO media VALUES (1, 1)',
+  'INSERT INTO pages VALUES (1)',
+  'INSERT INTO _pages_v VALUES (1, 1)',
+  'INSERT INTO _pages_v_rels VALUES (1, 1, 1)',
+]
+
+describe('dropDatabase', () => {
+  let configDir: string
+  let platform: PlatformProxy<{ DB: AnyD1Database }>
+
+  const tableNames = async () => {
+    const tables = await drizzle(platform.env.DB).all<{ name: string }>(
+      sql`SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name`,
+    )
+    return tables.map(({ name }) => name)
+  }
+
+  const createTables = () =>
+    platform.env.DB.batch([
+      platform.env.DB.prepare('PRAGMA defer_foreign_keys = on'),
+      ...schema.map((statement) => platform.env.DB.prepare(statement)),
+    ])
+
+  const adapter = () => ({ drizzle: drizzle(platform.env.DB) }) as unknown as SQLiteD1Adapter
+
+  beforeAll(() => {
+    configDir = mkdtempSync(path.join(tmpdir(), 'd1-drop-database-'))
+    writeFileSync(
+      path.join(configDir, 'wrangler.json'),
+      JSON.stringify({
+        compatibility_date: '2026-01-01',
+        d1_databases: [{ binding: 'DB', database_id: 'drop-database', database_name: 'test' }],
+        name: 'd1-drop-database',
+      }),
+    )
+  })
+
+  beforeEach(async () => {
+    const { getPlatformProxy } = await import('wrangler')
+    platform = await getPlatformProxy({
+      configPath: path.join(configDir, 'wrangler.json'),
+      persist: false,
+    })
+  })
+
+  afterEach(() => platform.dispose())
+
+  afterAll(() => rmSync(configDir, { force: true, recursive: true }))
+
+  it('drops tables whose rows reference each other and keeps D1 internal tables', async () => {
+    await createTables()
+
+    await dropDatabase({ adapter: adapter() })
+
+    expect(await tableNames()).toEqual(['_cf_METADATA'])
+  })
+
+  it('drops an FTS5 table, whose drop also removes its shadow tables', async () => {
+    await createTables()
+    await platform.env.DB.batch([
+      platform.env.DB.prepare('CREATE VIRTUAL TABLE search USING fts5(title)'),
+      platform.env.DB.prepare("INSERT INTO search VALUES ('Home')"),
+    ])
+
+    await dropDatabase({ adapter: adapter() })
+
+    expect(await tableNames()).toEqual(['_cf_METADATA'])
+  })
+
+  it('drops a database left by a migration that stopped partway', async () => {
+    await createTables()
+    await platform.env.DB.prepare('DROP TABLE pages').run()
+
+    await dropDatabase({ adapter: adapter() })
+
+    expect(await tableNames()).toEqual(['_cf_METADATA'])
+  })
+})
diff --git a/packages/db-d1-sqlite/src/dropDatabase.ts b/packages/db-d1-sqlite/src/dropDatabase.ts
new file mode 100644
index 000000000..8acdaee11
--- /dev/null
+++ b/packages/db-d1-sqlite/src/dropDatabase.ts
@@ -0,0 +1,43 @@
+import { sql } from 'drizzle-orm'
+
+import type { DropDatabase } from './types.js'
+
+import { dropOrder } from './dropOrder.js'
+
+/**
+ * Drops every table in one batch, which D1 runs as a transaction. D1 refuses to drop its own
+ * `_cf_` tables, and SQLite manages the `sqlite_` ones. Deferring foreign keys to the end of the
+ * batch lets tables in a reference cycle drop while their rows still reference each other.
+ * Dropping an FTS5 table also drops its shadow tables, which `IF EXISTS` then skips.
+ */
+export const dropDatabase: DropDatabase = async function ({ adapter }) {
+  const db = adapter.drizzle
+
+  const tables = (
+    await db.all<{ name: string }>(sql`SELECT name FROM sqlite_master WHERE type = 'table'`)
+  )
+    .map(({ name }) => name)
+    .filter((name) => !name.startsWith('_cf_') && !name.startsWith('sqlite_'))
+
+  if (!tables.length) {
+    return
+  }
+
+  const references = Object.fromEntries(
+    await Promise.all(
+      tables.map(async (name) => {
+        const foreignKeys = await db.all<{ table: string }>(
+          sql`PRAGMA foreign_key_list(${sql.identifier(name)})`,
+        )
+        return [name, foreignKeys.map(({ table }) => table)] as const
+      }),
+    ),
+  )
+
+  await db.batch([
+    db.run(sql`PRAGMA defer_foreign_keys = on`),
+    ...dropOrder(references).map((name) =>
+      db.run(sql`DROP TABLE IF EXISTS ${sql.identifier(name)}`),
+    ),
+  ])
+}
diff --git a/packages/db-d1-sqlite/src/dropOrder.ts b/packages/db-d1-sqlite/src/dropOrder.ts
new file mode 100644
index 000000000..40d36b8a4
--- /dev/null
+++ b/packages/db-d1-sqlite/src/dropOrder.ts
@@ -0,0 +1,35 @@
+/**
+ * Orders tables so that each one comes before the tables it references. D1 enforces foreign keys
+ * and ignores `PRAGMA foreign_keys = OFF`, and `PRAGMA defer_foreign_keys = on` doesn't help here:
+ * dropping a table fails with "no such table" when another table that references it also
+ * references a table that is already dropped. Tables in a reference cycle keep their given order.
+ *
+ * @param references each table's name, mapped to the names of the tables its foreign keys reference
+ */
+export const dropOrder = (references: Record<string, string[]>): string[] => {
+  const referencedBy = new Map<string, string[]>()
+
+  for (const [table, parents] of Object.entries(references)) {
+    for (const parent of parents) {
+      if (parent !== table) {
+        referencedBy.set(parent, [...(referencedBy.get(parent) ?? []), table])
+      }
+    }
+  }
+
+  const ordered: string[] = []
+  const visited = new Set<string>()
+
+  const visit = (table: string) => {
+    if (visited.has(table)) {
+      return
+    }
+    visited.add(table)
+    referencedBy.get(table)?.forEach(visit)
+    ordered.push(table)
+  }
+
+  Object.keys(references).forEach(visit)
+
+  return ordered
+}
