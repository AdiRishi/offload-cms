new file mode 100644
index 000000000..55128ab0d
--- /dev/null
+++ b/packages/plugin-ecommerce/src/utilities/ecommerceSlugs.ts
@@ -0,0 +1,26 @@
+import type { Config, SanitizedConfig } from 'payload'
+
+import type { CollectionSlugMap } from '../types/index.js'
+
+const key = '@payloadcms/plugin-ecommerce'
+
+/** Records the plugin's resolved collection slugs in `config.custom`, for server code to read. */
+export const recordCollectionSlugMap = (config: Config, collectionSlugMap: CollectionSlugMap) => {
+  config.custom = { ...config.custom, [key]: { collectionSlugMap } }
+}
+
+/**
+ * The collection slugs the ecommerce plugin was configured with, including any `slugMap` and
+ * `customers.slug`. Throws when the plugin isn't in the config.
+ */
+export const getEcommerceCollectionSlugs = (
+  config: Pick<SanitizedConfig, 'custom'>,
+): CollectionSlugMap => {
+  const recorded = config.custom?.[key]?.collectionSlugMap
+
+  if (!recorded) {
+    throw new Error('The ecommerce plugin is not in this Payload config.')
+  }
+
+  return recorded
+}
