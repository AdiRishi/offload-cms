+++ b/packages/plugin-ecommerce/src/utilities/settleTransaction.ts
@@ -0,0 +1,444 @@
+import {
+  commitTransaction,
+  type DefaultDocumentIDType,
+  initTransaction,
+  killTransaction,
+  type PayloadRequest,
+} from 'payload'
+
+import { getEcommerceCollectionSlugs } from './ecommerceSlugs.js'
+
+type RecordValue = Record<string, unknown>
+
+const SETTLEMENT_POLL_INTERVAL_MS = 25
+const SETTLEMENT_WAIT_TIMEOUT_MS = 500
+
+/**
+ * Another request holds the transaction's settlement and hadn't finished it when the wait ended.
+ * The payment is not lost: the order appears once that request finishes, so confirm again later.
+ */
+export class SettlementInProgressError extends Error {
+  constructor() {
+    super('Another request is still settling the transaction.')
+    this.name = 'SettlementInProgressError'
+  }
+}
+
+/**
+ * Another transaction's order already bought the cart: the customer paid twice. Settlement created
+ * nothing for this transaction and left it `pending`, or rolled back with the database transaction.
+ */
+export class CartAlreadyPurchasedError extends Error {
+  constructor(cartID: DefaultDocumentIDType) {
+    super(`Cart ${cartID} was already bought through another transaction.`)
+    this.name = 'CartAlreadyPurchasedError'
+  }
+}
+
+export type SettleTransactionArgs = {
+  /**
+   * The provider-validated data used to create the order. Settlement adds the canonical
+   * transaction relationship and owns all settlement side effects.
+   */
+  orderData: RecordValue
+  req: PayloadRequest
+  /**
+   * The ecommerce transaction that represents the payment.
+   */
+  transactionID: DefaultDocumentIDType
+}
+
+/**
+ * Turns a paid transaction into its order outside the confirm-order request, for example from a
+ * payment provider's webhook or a reconciliation job. Call it only after the provider has
+ * confirmed the payment.
+ *
+ * It settles the transaction the way confirm-order does: one atomic `pending` to `processing`
+ * claim, then the order, the cart's `purchasedAt`, the inventory and the `succeeded` status. A
+ * caller that loses the claim, such as a duplicate webhook or a concurrent confirm-order, gets the
+ * winner's order back and writes nothing. It runs in a database transaction when the adapter
+ * supports one and the request has none. Throws when the transaction cannot be settled, for example
+ * because it failed or expired, and throws `SettlementInProgressError` when another request is
+ * still settling it.
+ */
+export const settleTransaction = async ({
+  orderData,
+  req,
+  transactionID,
+}: SettleTransactionArgs): Promise<RecordValue> => {
+  const slugs = getEcommerceCollectionSlugs(req.payload.config)
+  const transactionsSlug = slugs.transactions
+  const ordersSlug = slugs.orders
+  const transaction = await req.payload.findByID({
+    id: transactionID,
+    collection: transactionsSlug,
+    depth: 0,
+    overrideAccess: true,
+    req,
+  })
+  const cartID = isRecord(transaction?.cart) ? transaction.cart.id : transaction?.cart
+
+  if (!isValidDocumentID(cartID)) {
+    throw new Error('Transaction has no cart to settle.')
+  }
+
+  const shouldCommit = await initTransaction(req)
+
+  try {
+    const order = await finalizeTransactionOrder({
+      cartID,
+      cartsSlug: slugs.carts,
+      orderData,
+      ordersSlug,
+      productsSlug: slugs.products,
+      req,
+      transactionID,
+      transactionsSlug,
+      variantsSlug: slugs.variants ?? 'variants',
+    })
+
+    if (shouldCommit) {
+      await commitTransaction(req)
+    }
+
+    return order
+  } catch (error) {
+    if (shouldCommit) {
+      await killTransaction(req)
+    }
+
+    if (shouldCommit && isTransientTransactionConflict(error)) {
+      return waitForCanonicalOrder({ ordersSlug, req, transactionID, transactionsSlug })
+    }
+
+    throw error
+  }
+}
+
+export const finalizeTransactionOrder = async ({
+  cartID,
+  cartsSlug,
+  orderData,
+  ordersSlug,
+  productsSlug,
+  req,
+  transactionID,
+  transactionsSlug,
+  variantsSlug,
+}: {
+  cartID: DefaultDocumentIDType
+  cartsSlug: string
+  orderData: Record<string, unknown>
+  ordersSlug: string
+  productsSlug: string
+  req: PayloadRequest
+  transactionID: DefaultDocumentIDType
+  transactionsSlug: string
+  variantsSlug: string
+}): Promise<RecordValue> => {
+  if (!isValidDocumentID(transactionID)) {
+    throw new Error('Transaction ID is missing or invalid.')
+  }
+
+  if (!isRecord(orderData)) {
+    throw new Error('Order data is missing or invalid.')
+  }
+
+  const claimedTransaction = await req.payload.db.updateOne({
+    collection: transactionsSlug,
+    data: { status: 'processing' },
+    options: { atomic: true },
+    req,
+    where: {
+      and: [
+        { id: { equals: transactionID } },
+        { status: { equals: 'pending' } },
+        { order: { exists: false } },
+      ],
+    },
+  })
+
+  if (!claimedTransaction) {
+    return waitForCanonicalOrder({ ordersSlug, req, transactionID, transactionsSlug })
+  }
+
+  if (getRelationshipID(claimedTransaction.id) !== getRelationshipID(transactionID)) {
+    throw new Error('Claimed transaction does not match the requested transaction.')
+  }
+
+  const transaction = await req.payload.findByID({
+    id: transactionID,
+    collection: transactionsSlug,
+    depth: 0,
+    overrideAccess: true,
+    req,
+  })
+
+  if (
+    !transaction ||
+    getRelationshipID(transaction.id) !== getRelationshipID(transactionID) ||
+    transaction.status !== 'processing'
+  ) {
+    throw new Error('Claimed transaction could not be loaded for settlement.')
+  }
+
+  const referencedOrders = await req.payload.find({
+    collection: ordersSlug,
+    depth: 0,
+    limit: 1,
+    overrideAccess: true,
+    pagination: false,
+    req,
+    where: { transactions: { equals: transactionID } },
+  })
+
+  if (referencedOrders.totalDocs !== 0 || referencedOrders.docs.length !== 0) {
+    throw new Error('An order already references the claimed transaction.')
+  }
+
+  let order: RecordValue
+
+  try {
+    order = (await req.payload.create({
+      collection: ordersSlug,
+      data: {
+        ...orderData,
+        cartKey: String(cartID),
+        settlementKey: String(transactionID),
+        transactions: [transactionID],
+      },
+      depth: 0,
+      overrideAccess: true,
+      req,
+    })) as RecordValue
+  } catch (error) {
+    if (!isUniqueViolationOf(error, ['cartKey', 'cart_key'])) {
+      throw error
+    }
+
+    // Without a database transaction nothing rolls the claim back, so release it here. Nothing
+    // else was written: the order is settlement's first write.
+    if (!(await req.transactionID)) {
+      await req.payload.db.updateOne({
+        collection: transactionsSlug,
+        data: { status: 'pending' },
+        options: { atomic: true },
+        req,
+        where: {
+          and: [
+            { id: { equals: transactionID } },
+            { status: { equals: 'processing' } },
+            { order: { exists: false } },
+          ],
+        },
+      })
+    }
+
+    throw new CartAlreadyPurchasedError(cartID)
+  }
+  const orderID = requireDocumentID({ fieldName: 'order ID', value: order.id })
+
+  await req.payload.update({
+    id: cartID,
+    collection: cartsSlug,
+    data: { purchasedAt: new Date().toISOString() },
+    depth: 0,
+    overrideAccess: true,
+    req,
+  })
+
+  await decrementInventory({
+    items: transaction.items,
+    productsSlug,
+    req,
+    variantsSlug,
+  })
+
+  await req.payload.update({
+    id: transactionID,
+    collection: transactionsSlug,
+    data: { order: orderID, status: 'succeeded' },
+    depth: 0,
+    overrideAccess: true,
+    req,
+  })
+
+  return order
+}
+
+const decrementInventory = async ({
+  items,
+  productsSlug,
+  req,
+  variantsSlug,
+}: {
+  items: unknown
+  productsSlug: string
+  req: PayloadRequest
+  variantsSlug: string
+}): Promise<void> => {
+  if (!Array.isArray(items) || items.length === 0) {
+    throw new Error('Inventory transaction items are missing or invalid.')
+  }
+
+  for (const item of items) {
+    if (
+      !isRecord(item) ||
+      typeof item.quantity !== 'number' ||
+      !Number.isFinite(item.quantity) ||
+      item.quantity <= 0
+    ) {
+      throw new Error('Inventory item quantity is missing or invalid.')
+    }
+
+    const hasVariant = item.variant !== null && item.variant !== undefined
+    const id = hasVariant ? item.variant : item.product
+
+    if (!isValidDocumentID(id)) {
+      throw new Error('Inventory item target is missing or invalid.')
+    }
+
+    const updatedInventory = await req.payload.db.updateOne({
+      id,
+      collection: hasVariant ? variantsSlug : productsSlug,
+      data: { inventory: { $inc: item.quantity * -1 } },
+      req,
+    })
+
+    if (!updatedInventory) {
+      throw new Error('Inventory item could not be updated.')
+    }
+  }
+}
+
+export const waitForCanonicalOrder = async ({
+  ordersSlug,
+  req,
+  transactionID,
+  transactionsSlug,
+}: {
+  ordersSlug: string
+  req: PayloadRequest
+  transactionID: DefaultDocumentIDType
+  transactionsSlug: string
+}): Promise<RecordValue> => {
+  const deadline = Date.now() + SETTLEMENT_WAIT_TIMEOUT_MS
+
+  do {
+    const transaction = await req.payload.findByID({
+      id: transactionID,
+      collection: transactionsSlug,
+      depth: 0,
+      overrideAccess: true,
+      req,
+    })
+
+    if (!transaction) {
+      throw new Error('Canonical transaction was not found.')
+    }
+
+    if (transaction.status === 'succeeded') {
+      return findExactlyLinkedOrder({
+        orderID: transaction.order,
+        ordersSlug,
+        req,
+        transactionID,
+      })
+    }
+
+    if (transaction.status !== 'pending' && transaction.status !== 'processing') {
+      throw new Error('Transaction is not available for settlement.')
+    }
+
+    if (Date.now() >= deadline) {
+      break
+    }
+
+    await new Promise<void>((resolve) =>
+      setTimeout(resolve, Math.min(SETTLEMENT_POLL_INTERVAL_MS, deadline - Date.now())),
+    )
+  } while (Date.now() <= deadline)
+
+  throw new SettlementInProgressError()
+}
+
+const findExactlyLinkedOrder = async ({
+  orderID,
+  ordersSlug,
+  req,
+  transactionID,
+}: {
+  orderID: unknown
+  ordersSlug: string
+  req: PayloadRequest
+  transactionID: DefaultDocumentIDType
+}): Promise<RecordValue> => {
+  const canonicalOrderID = requireDocumentID({ fieldName: 'order ID', value: orderID })
+  const result = await req.payload.find({
+    collection: ordersSlug,
+    depth: 0,
+    limit: 2,
+    overrideAccess: true,
+    pagination: false,
+    req,
+    where: { transactions: { equals: transactionID } },
+  })
+
+  if (
+    result.totalDocs !== 1 ||
+    result.docs.length !== 1 ||
+    getRelationshipID(result.docs[0]?.id) !== getRelationshipID(canonicalOrderID)
+  ) {
+    throw new Error('Transaction does not have exactly one canonical linked order.')
+  }
+
+  return result.docs[0] as RecordValue
+}
+
+export const isValidDocumentID = (id: unknown): id is DefaultDocumentIDType =>
+  (typeof id === 'number' && Number.isFinite(id)) ||
+  (typeof id === 'string' && id.trim().length > 0)
+
+export const getRelationshipID = (value: unknown): string | undefined => {
+  const id = isRecord(value) ? value.id : value
+
+  return isValidDocumentID(id) ? String(id) : undefined
+}
+
+const requireDocumentID = ({
+  fieldName,
+  value,
+}: {
+  fieldName: string
+  value: unknown
+}): DefaultDocumentIDType => {
+  const id = isRecord(value) ? value.id : value
+
+  if (!isValidDocumentID(id)) {
+    throw new Error(`${fieldName} is missing or invalid.`)
+  }
+
+  return id
+}
+
+const isRecord = (value: unknown): value is RecordValue =>
+  typeof value === 'object' && value !== null && !Array.isArray(value)
+
+const isUniqueViolationOf = (error: unknown, paths: string[]): boolean =>
+  isRecord(error) &&
+  error.name === 'ValidationError' &&
+  isRecord(error.data) &&
+  Array.isArray(error.data.errors) &&
+  error.data.errors.some((entry) => isRecord(entry) && paths.includes(String(entry.path)))
+
+export const isTransientTransactionConflict = (error: unknown): boolean => {
+  if (!isRecord(error)) {
+    return false
+  }
+
+  return (
+    error.code === 112 ||
+    error.codeName === 'WriteConflict' ||
+    (Array.isArray(error.errorLabels) && error.errorLabels.includes('TransientTransactionError'))
+  )
+}
