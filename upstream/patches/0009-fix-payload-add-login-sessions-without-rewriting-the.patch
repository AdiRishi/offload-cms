@@ -0,0 +1,83 @@
+import type { InStatement } from '@libsql/client'
+import type { FlattenedField } from 'payload'
+
+import { createClient } from '@libsql/client'
+import { drizzle } from 'drizzle-orm/libsql'
+import { integer, sqliteTable, text } from 'drizzle-orm/sqlite-core'
+import { describe, expect, it } from 'vitest'
+
+import type { DrizzleAdapter } from '../types.js'
+
+import { deleteWhere } from '../sqlite/deleteWhere.js'
+import { removeArrayRows } from './removeArrayRows.js'
+
+const usersSessions = sqliteTable('users_sessions', {
+  id: text('id').primaryKey(),
+  _parentID: integer('_parent_id').notNull(),
+})
+
+const fields = [
+  { name: 'name', type: 'text' },
+  { name: 'sessions', type: 'array', flattenedFields: [] },
+] as unknown as FlattenedField[]
+
+// D1 rejects a statement with more than 100 bound parameters.
+const setup = async () => {
+  const client = createClient({ url: ':memory:' })
+  await client.execute('CREATE TABLE users_sessions (id TEXT PRIMARY KEY, _parent_id INTEGER)')
+
+  const execute = client.execute.bind(client)
+  client.execute = ((statement: InStatement) => {
+    if (
+      typeof statement === 'object' &&
+      Array.isArray(statement.args) &&
+      statement.args.length > 100
+    ) {
+      throw new Error('too many SQL variables')
+    }
+    return execute(statement)
+  }) as typeof client.execute
+
+  const db = drizzle(client)
+  const adapter = {
+    deleteWhere,
+    limitedBoundParameters: true,
+    tableNameMap: new Map([['users_sessions', 'users_sessions']]),
+    tables: { users_sessions: usersSessions },
+  } as unknown as DrizzleAdapter
+
+  return { adapter, db }
+}
+
+const sessionIDs = (parentID: number, count: number) =>
+  Array.from({ length: count }, (_, i) => `${parentID}-${i}`)
+
+describe('removeArrayRows', () => {
+  it("deletes only the named rows of the parent's array, within 100 bound parameters", async () => {
+    const { adapter, db } = await setup()
+    const ownSessions = sessionIDs(1, 150)
+    const otherUsersSessions = sessionIDs(2, 2)
+    for (const id of ownSessions) {
+      await db.insert(usersSessions).values({ id, _parentID: 1 })
+    }
+    for (const id of otherUsersSessions) {
+      await db.insert(usersSessions).values({ id, _parentID: 2 })
+    }
+
+    const remainingData = await removeArrayRows({
+      adapter,
+      data: {
+        name: 'Ada',
+        sessions: { $remove: [...ownSessions.slice(0, 120), otherUsersSessions[0]] },
+      },
+      db,
+      fields,
+      parentID: 1,
+      tableName: 'users',
+    })
+
+    expect(remainingData).toEqual({ name: 'Ada' })
+    const remainingIDs = (await db.select().from(usersSessions)).map(({ id }) => id).sort()
+    expect(remainingIDs).toEqual([...ownSessions.slice(120), ...otherUsersSessions].sort())
+  })
+})
diff --git a/packages/drizzle/src/upsertRow/removeArrayRows.ts b/packages/drizzle/src/upsertRow/removeArrayRows.ts
new file mode 100644
index 000000000..f2e659759
--- /dev/null
+++ b/packages/drizzle/src/upsertRow/removeArrayRows.ts
@@ -0,0 +1,59 @@
+import type { FlattenedField } from 'payload'
+
+import { and, eq, inArray } from 'drizzle-orm'
+import toSnakeCase from 'to-snake-case'
+
+import type { DrizzleAdapter, DrizzleTransaction } from '../types.js'
+
+type Args = {
+  adapter: DrizzleAdapter
+  data: Record<string, unknown>
+  db: DrizzleAdapter['drizzle'] | DrizzleTransaction
+  fields: FlattenedField[]
+  parentID: number | string
+  tableName: string
+}
+
+/**
+ * Deletes the rows that `{ [arrayField]: { $remove: id | id[] } }` names from top-level array
+ * fields, and returns the data without those operations.
+ */
+export const removeArrayRows = async ({
+  adapter,
+  data,
+  db,
+  fields,
+  parentID,
+  tableName,
+}: Args): Promise<Record<string, unknown>> => {
+  const remainingData = { ...data }
+
+  for (const field of fields) {
+    const value = data[field.name]
+
+    if (field.type !== 'array' || typeof value !== 'object' || !value || !('$remove' in value)) {
+      continue
+    }
+
+    const ids: unknown[] = Array.isArray(value.$remove) ? value.$remove : [value.$remove]
+    const arrayTableName = adapter.tableNameMap.get(`${tableName}_${toSnakeCase(field.name)}`)
+    const table = adapter.tables[arrayTableName]
+    // A limited database accepts 100 bound parameters, and the parent ID takes one
+    const batchSize = adapter.limitedBoundParameters ? 99 : ids.length
+
+    for (let offset = 0; offset < ids.length; offset += batchSize) {
+      await adapter.deleteWhere({
+        db,
+        tableName: arrayTableName,
+        where: and(
+          eq(table._parentID, parentID),
+          inArray(table.id, ids.slice(offset, offset + batchSize)),
+        ),
+      })
+    }
+
+    delete remainingData[field.name]
+  }
+
+  return remainingData
+}
