{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offload-e2e",
  "main": "src/server.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "D1", "database_name": "offload-e2e", "database_id": "local" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "offload-e2e" }],
  "send_email": [{ "name": "EMAIL" }],
  "images": { "binding": "IMAGES" },
  // Form submissions allowed per visitor IP, per minute.
  "ratelimits": [
    { "name": "SUBMISSIONS", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
  ],
  "env": {
    // Postgres through Hyperdrive. Select it with CLOUDFLARE_ENV=postgres.
    "postgres": {
      // Unused here, but every environment binds D1 so the generated Env type requires it.
      "d1_databases": [{ "binding": "D1", "database_name": "offload-e2e", "database_id": "local" }],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "local",
          "localConnectionString": "postgres://offload:offload@localhost:54329/offload_e2e",
        },
      ],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "offload-e2e" }],
      "send_email": [{ "name": "EMAIL" }],
      "images": { "binding": "IMAGES" },
      "ratelimits": [
        { "name": "SUBMISSIONS", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
      ],
    },
    // A real deployment on Cloudflare, for behaviour that local workerd doesn't reproduce.
    // Deploy with `pnpm deploy:staging`, which drops every table in its D1 database first.
    "staging": {
      "account_id": "34c911069f69b7cc1f38573958c3db45",
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "offload-staging",
          "database_id": "03f3ab96-248a-4bab-bd0b-2eea2268da2b",
          "remote": true,
        },
      ],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "offload-staging", "remote": true }],
      // Email Service sends only from a domain onboarded to Email Sending.
      "send_email": [{ "name": "EMAIL" }],
      "images": { "binding": "IMAGES" },
      "ratelimits": [
        { "name": "SUBMISSIONS", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
      ],
    },
  },
}
