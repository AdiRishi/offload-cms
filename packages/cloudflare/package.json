{
  "name": "@adirishi/offload-cloudflare",
  "version": "0.0.0",
  "description": "Run Offload (Payload v4 with TanStack Start) on Cloudflare Workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@payloadcms/tanstack-start": "4.0.0-beta.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.3",
    "@tools/tsconfig": "workspace:*",
    "@types/node": "24.12.3",
    "@types/pg": "8.20.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitejs/plugin-rsc": "0.5.38",
    "graphql": "16.11.0",
    "payload": "4.0.0-beta.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@payloadcms/tanstack-start": "4.0.0-beta.2",
    "@tanstack/react-start": "^1.169.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.21",
    "payload": "4.0.0-beta.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
