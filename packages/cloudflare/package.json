{
  "name": "@adirishi/offload-cloudflare",
  "version": "0.0.0",
  "description": "Vite preset, bindings and Worker entry for Payload sites on Cloudflare Workers",
  "homepage": "https://github.com/AdiRishi/offload-cms/tree/main/packages/cloudflare#readme",
  "bugs": {
    "url": "https://github.com/AdiRishi/offload-cms/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git",
    "directory": "packages/cloudflare"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@payloadcms/tanstack-start": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "catalog:",
    "graphql": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "peerDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@payloadcms/tanstack-start": "4.0.0-beta.2",
    "@tanstack/react-start": "^1.169.1",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.21",
    "payload": "4.0.0-beta.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.0"
  }
}
