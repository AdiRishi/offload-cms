{
  "name": "{{name}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cf-typegen": "wrangler types",
    "migrate": "payload migrate",
    "migrate:regenerate": "rm -rf src/migrations && payload migrate:create initial && pnpm db:reset",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && payload migrate",
    "admin:dev": "payload run scripts/create-dev-admin.ts",
    "deploy": "CLOUDFLARE_ENV=production pnpm migrate && CLOUDFLARE_ENV=production pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@adirishi/offload-cloudflare": "{{version}}",
    "@adirishi/offload-tanstack": "{{version}}",
    "@payloadcms/db-d1-sqlite": "npm:@adirishi/offload-db-d1-sqlite@{{version}}",
    "@payloadcms/richtext-lexical": "npm:@adirishi/offload-richtext-lexical@{{version}}",
    "@payloadcms/storage-r2": "npm:@adirishi/offload-storage-r2@{{version}}",
    "@payloadcms/tanstack-start": "npm:@adirishi/offload-tanstack-start@{{version}}",
    "@payloadcms/transformer-cloudflare": "npm:@adirishi/offload-transformer-cloudflare@{{version}}",
    "@payloadcms/ui": "npm:@adirishi/offload-ui@{{version}}",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.3",
    "graphql": "^16.11.0",
    "payload": "npm:@adirishi/offload-payload@{{version}}",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.38",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
