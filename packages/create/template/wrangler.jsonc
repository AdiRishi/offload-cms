{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{name}}",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Runs Payload's jobs, such as scheduled publishing.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{ "binding": "D1", "database_name": "{{name}}", "database_id": "local" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "{{name}}" }],
  "images": { "binding": "IMAGES" },
  "env": {
    // The deployed site. CLOUDFLARE_ENV=production selects it for the Payload CLI and the build.
    // Environments don't inherit bindings or vars, so it lists each one again. Without "name",
    // Wrangler would deploy it as {{name}}-production.
    "production": {
      "name": "{{name}}",
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "{{name}}",
          "database_id": "<the ID that wrangler d1 create prints>",
          "remote": true,
        },
      ],
      "r2_buckets": [{ "binding": "R2", "bucket_name": "{{name}}", "remote": true }],
      "images": { "binding": "IMAGES", "remote": true },
    },
  },
}
