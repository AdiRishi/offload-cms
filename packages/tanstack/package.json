{
  "name": "@adirishi/offload-tanstack",
  "version": "0.0.0",
  "description": "Payload's Local API per request, drafts, Live Preview, redirects and error hiding for TanStack Start sites on Offload",
  "homepage": "https://github.com/AdiRishi/offload-cms/tree/main/packages/tanstack#readme",
  "bugs": {
    "url": "https://github.com/AdiRishi/offload-cms/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git",
    "directory": "packages/tanstack"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/live-preview-react": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@repo/upstream": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/react": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.1",
    "payload": "4.0.0-beta.3",
    "react": "^19.2.0"
  }
}
