{
  "name": "@adirishi/offload-tanstack",
  "version": "0.0.0",
  "description": "Payload content in TanStack Start sites on Offload: the Local API per request, drafts, Live Preview, redirects, blocks, SEO tags, responsive images, links, admin helpers and seed helpers",
  "homepage": "https://github.com/AdiRishi/offload-cms/tree/main/packages/tanstack#readme",
  "bugs": {
    "url": "https://github.com/AdiRishi/offload-cms/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git",
    "directory": "packages/tanstack"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin/client": {
      "types": "./dist/admin/client.d.ts",
      "default": "./dist/admin/client.js"
    },
    "./admin/rsc": {
      "types": "./dist/admin/rsc.d.ts",
      "default": "./dist/admin/rsc.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "default": "./dist/fields.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/live-preview-react": "catalog:"
  },
  "devDependencies": {
    "@payloadcms/plugin-seo": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/ui": "catalog:",
    "@repo/tsconfig": "workspace:*",
    "@repo/upstream": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/react": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@payloadcms/plugin-seo": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.1",
    "payload": "4.0.0-beta.3",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@payloadcms/plugin-seo": {
      "optional": true
    },
    "@payloadcms/richtext-lexical": {
      "optional": true
    }
  }
}
