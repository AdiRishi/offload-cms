{
  "name": "offload-cms",
  "private": true,
  "description": "Payload CMS v4 for TanStack Start sites on Cloudflare Workers",
  "homepage": "https://github.com/AdiRishi/offload-cms#readme",
  "bugs": {
    "url": "https://github.com/AdiRishi/offload-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint format check-types",
    "check-types": "turbo run check-types",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "registry": "pnpm --filter @tools/release registry",
    "release": "node tools/release/src/release.ts",
    "test:e2e": "pnpm --dir apps/e2e e2e",
    "test:e2e:postgres": "pnpm --dir apps/e2e e2e:postgres",
    "upstream:checkout": "upstream checkout",
    "upstream:export": "upstream export",
    "upstream:status": "upstream status",
    "upstream:upgrade": "upstream upgrade",
    "use-version": "node tools/release/src/use-version.ts"
  },
  "devDependencies": {
    "@repo/upstream": "workspace:*",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.25.0"
}
