{
  "name": "offload-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types && tsc -p tools/tsconfig.json",
    "upstream:checkout": "node tools/upstream/checkout.ts",
    "upstream:export": "node tools/upstream/export.ts",
    "upstream:status": "node tools/upstream/status.ts",
    "upstream:upgrade": "node tools/upstream/upgrade.ts",
    "registry:start": "verdaccio --config tools/registry/config.yaml --listen 4873",
    "release": "node tools/release/release.ts",
    "use-version": "node tools/release/use-version.ts"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2",
    "verdaccio": "6.10.5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
