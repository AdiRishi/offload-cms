{
  "name": "offload-cms",
  "private": true,
  "description": "Payload CMS on Cloudflare Workers",
  "homepage": "https://github.com/AdiRishi/offload-cms#readme",
  "bugs": {
    "url": "https://github.com/AdiRishi/offload-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git"
  },
  "type": "module",
  "scripts": {
    "build": "dotenv -e .env.turbo.local -- turbo run build",
    "check": "dotenv -e .env.turbo.local -- turbo run lint format typecheck test",
    "docs:build": "dotenv -e .env.turbo.local -- turbo run build --filter=@repo/docs",
    "docs:dev": "pnpm --filter @repo/docs dev",
    "docs:registry": "pnpm --filter @repo/docs registry",
    "e2e:deploy:staging": "pnpm --dir e2e deploy:staging",
    "e2e:lint": "pnpm --dir e2e lint",
    "e2e:migrations:check": "pnpm --dir e2e migrations:check",
    "e2e:migrations:regenerate": "pnpm --dir e2e migrations:regenerate",
    "e2e:registry": "pnpm docs:registry && pnpm --dir e2e registry",
    "e2e:serve": "pnpm --dir e2e serve",
    "e2e:size": "pnpm --dir e2e size",
    "e2e:test": "pnpm --dir e2e test",
    "e2e:test:dev": "pnpm --dir e2e test:dev",
    "e2e:test:postgres": "CLOUDFLARE_ENV=postgres pnpm --dir e2e test",
    "e2e:test:reuse": "pnpm --dir e2e test:reuse",
    "e2e:typecheck": "pnpm --dir e2e typecheck",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "release": "dotenv -e .env.turbo.local -- release",
    "test": "dotenv -e .env.turbo.local -- turbo run test",
    "typecheck": "dotenv -e .env.turbo.local -- turbo run typecheck",
    "upstream": "dotenv -e .env.turbo.local -- upstream"
  },
  "devDependencies": {
    "@repo/release": "workspace:*",
    "@repo/upstream": "workspace:*",
    "dotenv-cli": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
