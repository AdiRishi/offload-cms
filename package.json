{
  "name": "offload-cms",
  "private": true,
  "description": "Payload CMS v4 for TanStack Start sites on Cloudflare Workers",
  "homepage": "https://github.com/AdiRishi/offload-cms#readme",
  "bugs": {
    "url": "https://github.com/AdiRishi/offload-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdiRishi/offload-cms.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run lint format check-types test",
    "check-types": "turbo run check-types",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "release": "turbo run publish",
    "test": "turbo run test",
    "test:e2e": "release e2e",
    "test:e2e:postgres": "release e2e --postgres",
    "upstream:checkout": "upstream checkout",
    "upstream:export": "upstream export",
    "upstream:status": "upstream status",
    "upstream:upgrade": "upstream upgrade",
    "use-version": "release use-version"
  },
  "devDependencies": {
    "@repo/release": "workspace:*",
    "@repo/upstream": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
