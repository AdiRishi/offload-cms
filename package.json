{
  "name": "offload-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "upstream:checkout": "node tools/upstream/checkout.ts",
    "upstream:export": "node tools/upstream/export.ts",
    "upstream:status": "node tools/upstream/status.ts",
    "upstream:upgrade": "node tools/upstream/upgrade.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
