{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".node-version"],
  "remoteCache": {
    "apiUrl": "https://turbo-cache.adishwar-rishi.com",
    "teamId": "team_offload",
    "signature": true
  },
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#lint": {
      "dependsOn": ["@repo/upstream#build"],
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
