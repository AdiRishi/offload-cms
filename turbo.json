{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "//#lint": {
      "dependsOn": ["@repo/upstream#build"],
      "cache": false
    },
    "//#format": {
      "cache": false
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
