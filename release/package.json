{
  "name": "@repo/release",
  "version": "0.0.0",
  "private": true,
  "description": "Publishes the patched Payload and Offload's own packages as @adirishi/offload-*",
  "bin": {
    "release": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "check-types": "tsc --noEmit",
    "publish": "node src/cli.ts publish",
    "registry": "verdaccio --config registry.yaml --listen 4873",
    "test": "node --test"
  },
  "dependencies": {
    "@repo/upstream": "workspace:*"
  },
  "devDependencies": {
    "@adirishi/offload-cloudflare": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/node": "24.12.3",
    "typescript": "7.0.2",
    "verdaccio": "6.10.5"
  }
}
