{
  "name": "@repo/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The Offload documentation site, built with Blume",
  "type": "module",
  "scripts": {
    "build": "pnpm registry && blume build",
    "typecheck": "blume check --strict --isolated",
    "dev": "pnpm registry && blume dev",
    "registry": "shadcn build registry.json --cwd ../packages/form-builder --output ../../docs/public/r",
    "test": "blume validate --strict"
  },
  "devDependencies": {
    "@repo/upstream": "workspace:*",
    "blume": "catalog:",
    "shadcn": "catalog:"
  }
}
