{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offload-poc",
  "main": "src/server.ts",
  "triggers": { "crons": ["*/5 * * * *"] },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "D1", "database_name": "offload-poc", "database_id": "local-poc" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "offload-poc" }],
  "vars": { "PAYLOAD_SECRET": "poc-secret-not-for-production" }
}
