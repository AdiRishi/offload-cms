{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["test", "describe", "it", "suite", "before", "after"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.wrangler/**",
    "upstream/payload/**",
    "upstream/patches/**",
    "e2e/src/migrations/**",
    "e2e/src/payload-types.ts",
    "e2e/src/routeTree.gen.ts",
    "e2e/src/app/_payload/importMap.js",
    "e2e/worker-configuration.d.ts"
  ]
}
