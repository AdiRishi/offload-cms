{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "rules": {
    "eslint/no-underscore-dangle": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["test", "describe", "it", "suite", "before", "after"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.wrangler/**",
    "docs/.blume/**",
    "docs/.blume-verify/**",
    "upstream/payload/**",
    "upstream/patches/**",
    "packages/create/template/**",
    "e2e/**"
  ],
  "overrides": [
    {
      "files": ["packages/form-builder/registry/**"],
      "rules": {
        "typescript/no-redundant-type-constituents": "off"
      }
    }
  ]
}
